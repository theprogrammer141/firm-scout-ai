{
  "name": "firmscout-ai",
  "version": "1.0.0",
  "private": true,
  "description": "FirmScout AI - multi-agent sales intelligence platform powered by Alibaba Cloud Qwen (DashScope)",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "node server/src/scripts/seed.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test": "node --test \"server/test/*.test.js\"",
    "verify": "node server/test/verify-live.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
