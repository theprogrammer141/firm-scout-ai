# ---------------------------------------------------------------------------
# FirmScout AI - environment configuration
# Copy to .env and fill in your DashScope API key.
# ---------------------------------------------------------------------------

# REQUIRED: Alibaba Cloud DashScope API key (Qwen models).
# Get one at https://dashscope.console.aliyun.com/ (China) or
# https://modelstudio.console.alibabacloud.com/ (International)
DASHSCOPE_API_KEY=

# DashScope OpenAI-compatible base URL.
# International (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Mainland China (Beijing):  https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen model routing per agent tier.
QWEN_MODEL_REASONING=qwen-plus
QWEN_MODEL_FAST=qwen-turbo
QWEN_MODEL_VISION=qwen-vl-plus

# Server
PORT=5050
NODE_ENV=development

# Research cache TTL in hours (avoids burning DashScope quota re-researching)
RESEARCH_CACHE_TTL_HOURS=24

# Max characters of scraped website text passed to the model (untrusted evidence)
WEBSITE_TEXT_LIMIT=6000

# Rate limiting for expensive AI endpoints
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=30
